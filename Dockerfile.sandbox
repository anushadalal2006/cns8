FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv git cmake ninja-build build-essential \
    libssl-dev curl wget nano iproute2 iputils-ping tcpdump ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# --- sandbox only: trust the TLS-intercepting egress proxy of the build machine ---
COPY ccr-ca-bundle.crt /etc/ssl/certs/ccr-ca-bundle.crt
ENV PIP_CERT=/etc/ssl/certs/ccr-ca-bundle.crt SSL_CERT_FILE=/etc/ssl/certs/ccr-ca-bundle.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ccr-ca-bundle.crt GIT_SSL_CAINFO=/etc/ssl/certs/ccr-ca-bundle.crt
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --no-cache-dir cryptography matplotlib pandas liboqs-python
# The first import makes liboqs-python download and build liboqs (a few minutes)
RUN python3 -c "import oqs; print(oqs.oqs_version())"
WORKDIR /lab
CMD ["sleep", "infinity"]
