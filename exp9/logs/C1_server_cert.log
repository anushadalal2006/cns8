anush@anusha:~/pki-lab$ openssl genrsa -out server/server.key.pem 2048

anush@anusha:~/pki-lab$ openssl req -new -key server/server.key.pem \
  -subj '/O=CSE Lab/CN=server.lab.local' -out server/server.csr.pem

anush@anusha:~/pki-lab$ openssl ca -batch -config intermediate/openssl.cnf -extensions server_cert \
  -days 365 -notext -md sha256 \
  -in server/server.csr.pem -out server/server.cert.pem
Using configuration from intermediate/openssl.cnf
