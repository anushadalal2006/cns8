anush@anusha:~/pki-lab$ cat > nginx/nginx.conf <<'EOF'
pid /home/anush/pki-lab/nginx/nginx.pid;
error_log /home/anush/pki-lab/nginx/error.log info;
events {}
http {
  access_log /home/anush/pki-lab/nginx/access.log;
  server {
    listen 8443 ssl;
    server_name server.lab.local;

    ssl_certificate         /home/anush/pki-lab/server/server.fullchain.pem;
    ssl_certificate_key     /home/anush/pki-lab/server/server.key.pem;
    ssl_protocols           TLSv1.2 TLSv1.3;

    ssl_client_certificate  /home/anush/pki-lab/intermediate/certs/ca-chain.cert.pem;
    ssl_verify_client       on;
    ssl_verify_depth        2;

    location / {
      return 200 'Hello $ssl_client_s_dn | verify=$ssl_client_verify | proto=$ssl_protocol';
    }
  }
}
EOF

anush@anusha:~/pki-lab$ echo $HOME
/home/anush

anush@anusha:~/pki-lab$ nginx -p $PKI/nginx -c $PKI/nginx/nginx.conf

